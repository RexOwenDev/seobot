{
  "name": "seobot",
  "version": "0.1.0",
  "private": true,
  "description": "SEOBot — AI content & SEO pipeline skeleton (keyword → SEO article → WordPress/Shopify publish). Portfolio showcase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
