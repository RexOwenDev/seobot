# =============================================================================
# SEOBot — environment variable reference
# =============================================================================
# This project is a SKELETON — no live API calls. These variables document the
# interface required for operator production deployment. All values below must
# be supplied by the operator; the public repo ships no working credentials.
#
# Copy to .env.local for local development. NEVER commit .env.local.
# =============================================================================

# --- AI Gateway (Vercel) -----------------------------------------------------
# Operator-supplied. Used via AI SDK v6 with gateway('anthropic/claude-sonnet-4.6')
AI_GATEWAY_API_KEY=

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- WordPress CMS (per-workspace in production — .env is dev reference) -----
# Auth method: WordPress Application Passwords (wp-admin → Users → Profile)
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Shopify CMS (per-workspace in production — .env is dev reference) -------
# Auth method: Shopify Admin API access token (custom app)
SHOPIFY_SHOP=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Google Search Console (service account) --------------------------------
GSC_SERVICE_ACCOUNT_EMAIL=
# Paste raw key; runtime normalizes escaped newlines.
GSC_PRIVATE_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Scripts only (not deployed to Vercel) -----------------------------------
# Used by scripts/generate-hero.mjs for Gemini Imagen 4.0. Operator-supplied.
GEMINI_API_KEY=
